# Copy to .env (gitignored). infra/azure.sh writes the real values here.
AZ_SUBSCRIPTION=
AZ_LOCATION=westus2
AZ_RG=rg-personal-garmin
AZ_STORAGE=stgordongarmin
AZ_CONTAINER=mf
AZ_BLOB=state.json

# Filled in by infra/azure.sh. Never commit.
BLOB_URL=
READ_SAS_URL=
WRITE_SAS_URL=

# From the Pushcut app: Notifications > "MF Log" > Webhook URL. Never commit.
PUSHCUT_URL=
